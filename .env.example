# ─────────────────────────────────────────────────────────────
# 环境变量模板
# 复制本文件为 .env.local 后填入你自己的值。
# .env.local 已被 .gitignore 忽略，绝不会被提交到仓库。
# ─────────────────────────────────────────────────────────────
#
# 【注意】本项目没有 Key 也能完整跑通全流程：
# 检测不到 Key 时会自动降级到「本地关键词词典」解析需求，
# 界面、筛选、解释全部正常，只是理解自然语言的能力变弱。
#
# 【安全】Key 只在服务端读取，浏览器里永远看不到它。
# ─────────────────────────────────────────────────────────────

# ── 供应商选择（留空 = qwen，即通义千问）──────────────────────
# 可选：qwen / deepseek / zhipu / moonshot / siliconflow / ollama / custom
# 想让访客换成自己的接口，填 custom 并配置下面三项即可。
AI_PROVIDER=qwen

# 使用的模型名（留空则用该供应商的默认值）
# AI_MODEL=qwen3.8-flash

# 接口地址（留空则用该供应商的默认值；custom 模式下必填）
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 各家 API Key（填一个就行，用哪个填哪个）──────────────────
# 通义千问（阿里云百炼）—— https://bailian.console.aliyun.com/settings/api-key
# 新人每个模型送 100 万 token 免费额度，90 天有效，只有北京地域有额度。
DASHSCOPE_API_KEY=

# 备选：DeepSeek —— https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 备选：智谱 GLM —— https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 备选：Kimi —— https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# 备选：硅基流动 —— https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# ── custom 模式专用（想接任何 OpenAI 兼容端点都行）───────────
# 例：本地 Ollama 填 http://localhost:11434/v1，模型填 qwen2.5:7b，Key 留空即可
AI_API_KEY=

# ── RAG 语义检索（可选，复用 DASHSCOPE_API_KEY，无需新 Key）───
# 检测到 DASHSCOPE_API_KEY 时，RAG 检索自动走「语义检索（embedding 向量）」；
# 没 Key 或接口失败会自动回退「词法检索（BM25）」，不影响功能。
# 强制关闭语义检索（只走词法）可设为 off：
# RAG_EMBEDDING=off

# ─────────────────────────────────────────────────────────────
# 说明：以上供应商全部走 OpenAI 兼容的 /chat/completions 协议，
# 所以换任何一家都只是改配置，不用改代码。
# ─────────────────────────────────────────────────────────────
